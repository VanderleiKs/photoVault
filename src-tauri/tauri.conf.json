{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoVault",
  "version": "2.0.0",
  "identifier": "com.photovault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/photovault/browser"
  },
  "app": {
    "windows": [
      {
        "title": "PhotoVault",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "label": "main",
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' pv: http://pv.localhost data: blob:",
        "media-src": "'self' pv: http://pv.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' pv: http://pv.localhost data: blob:",
        "media-src": "'self' pv: http://pv.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:4200 http://localhost:4200"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
